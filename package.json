{
  "name": "wardo",
  "version": "0.1.0",
  "description": "Durable TypeScript orchestration for Codex and Claude Code agents",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "wardo": "dist/cli.js" },
  "exports": {
    ".": "./dist/index.js",
    "./config": "./dist/config.js",
    "./agents": "./dist/agents/index.js"
  },
  "files": ["dist", "skill", "skills", "templates"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "2.0.105",
    "@ai-sdk/openai": "2.0.130",
    "@anthropic-ai/claude-agent-sdk": "0.3.282",
    "@openai/codex-sdk": "0.157.0",
    "ai": "6.0.291",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "overrides": {
    "@ai-sdk/provider-utils": {
      "undici": "6.28.1"
    }
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
